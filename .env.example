# 🚗 MACONDO EXPRESS · CONFIGURACIÓN DE ENTORNO
# Duplicar este archivo como .env y configurar con las credenciales de Supabase

# URL base del proyecto Supabase
SUPABASE_URL=https://tu-proyecto-macondo.supabase.co

# Llave pública anónima (Anon Public Key) para apps cliente (Pasajero y Conductor)
SUPABASE_ANON_KEY=tu_supabase_anon_key_aqui

# Configuración de puerto para simulador web (opcional)
PORT=8092
